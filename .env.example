POSTGRES_URL=postgres://user:password@localhost:5432/your-database-name
PAYLOAD_SECRET=YOUR_SECRET_HERE
PAYLOAD_DB_PUSH=false

# Cloudinary — Settings -> API Keys in the Cloudinary dashboard.
# Required everywhere: the app refuses to start without them, in development
# too. All uploads and all media delivery go through Cloudinary.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=000000000000000
CLOUDINARY_API_SECRET=your-api-secret
# Optional credit-saving fallback: serve the copies committed under public/
# instead of the CDN. Leave unset to serve everything from Cloudinary.
# MEDIA_DELIVERY=local

# Outgoing email (enquiry and newsletter forms) through Gmail SMTP.
# SMTP_PASS is a Google App Password, not the account password: enable 2-Step
# Verification, then create one at https://myaccount.google.com/apppasswords.
# Without SMTP_USER and SMTP_PASS, emails are printed to the server console.
SMTP_USER=your-account@gmail.com
SMTP_PASS=
# Where new enquiries and subscribers are sent. Defaults to SMTP_USER.
CONTACT_NOTIFY_TO=
# Used for the admin link in notification emails.
NEXT_PUBLIC_SERVER_URL=https://www.skywings.ae

# Cloudflare Turnstile (optional human check on the enquiry form).
# Create a widget at https://dash.cloudflare.com/?to=/:account/turnstile.
# The widget shows once the site key is set; the server enforces it once the
# secret is set, so set both together.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Newsletter sending. Vercel Cron calls /newsletter/dispatch daily with this
# secret, and the site uses it to start sending runs itself. Any long random
# string, e.g. `openssl rand -hex 32`. Required in production.
CRON_SECRET=

# Lets `pnpm run refresh:cache` clear a running server's data cache after a
# seed or script (POST /revalidate). Optional in development; set it in
# production, or the route refuses every request.
REVALIDATE_SECRET=
