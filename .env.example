POSTGRES_URL=postgres://user:password@localhost:5432/your-database-name
PAYLOAD_SECRET=YOUR_SECRET_HERE
PAYLOAD_DB_PUSH=false

# Cloudinary — Settings -> API Keys in the Cloudinary dashboard.
# Uploads fall back to local disk in development if these are unset; the app
# refuses to boot in production rather than silently losing files.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=000000000000000
CLOUDINARY_API_SECRET=your-api-secret
# Files mirrored into the deployment (pnpm run mirror:media) are served locally
# to save Cloudinary credits. Set to `cloudinary` to serve everything from the CDN.
# MEDIA_DELIVERY=cloudinary
